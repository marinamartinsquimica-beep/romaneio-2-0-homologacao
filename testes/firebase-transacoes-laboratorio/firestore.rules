rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Lab documents are readable only to verified Firebase users.
    // All client writes are denied; only the authenticated, narrowly-scoped
    // Cloud Functions Admin transaction may create/update these documents.
    match /rom_lab_transacoes_paletes/{palletId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }
    match /rom_lab_transacoes_operacoes/{operationId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }
    match /rom_lab_transacoes_auditoria/{eventId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    // Deny all other documents. This file is a complete ruleset for the
    // dedicated laboratory project, not a merge-safe fragment for production.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
